FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY apps/api/package*.json ./apps/api/

# Install dependencies
RUN npm ci

# Copy source
COPY . .

# Build
RUN npm run build --workspace=apps/api

# Set working directory to API
WORKDIR /app/apps/api

# Expose port
EXPOSE 3000

# Start command
CMD ["npm", "run", "start:prod"]
