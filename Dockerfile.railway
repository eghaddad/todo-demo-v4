FROM node:20-alpine

WORKDIR /app

# Copy API package files
COPY apps/api/package*.json ./
COPY apps/api/nest-cli.json apps/api/tsconfig*.json ./

# Install dependencies
RUN npm install

# Copy source
COPY apps/api/src ./src

# Build
RUN npm run build

# Expose port
EXPOSE 3000

# Start
CMD ["npm", "run", "start:prod"]
